rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTripMember(tripId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    match /trips/{tripId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update: if (
          isSignedIn()
          && resource.data.createdBy == request.auth.uid
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasOnly(
            resource.data.memberIds.concat([request.auth.uid])
          )
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size()
            == resource.data.members.size() + 1
        );

      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isTripMember(tripId);

        allow create: if isTripMember(tripId)
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if isTripMember(tripId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
